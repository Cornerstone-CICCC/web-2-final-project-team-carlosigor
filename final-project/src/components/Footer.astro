---
import logo from "../assets/logo.png";
import { Facebook, Instagram, Twitter, Linkedin } from "@lucide/astro";
---

<footer class="footer">
  <div class="container">
  
    <div class="footer-desktop">
      <div class="footer-top">
        <div class="newsletter-section-desktop">
          <div class="logo">
            <img src={logo.src} class="logo-icon" alt="Ddsgnr logo" />
            <span class="logo-text">Ddsgnr</span>
          </div>
          <p class="newsletter-text">
            Join our newsletter to stay up to date on features and releases.
          </p>
          <form class="newsletter-form form-news">
            <input type="email" name="email" id="email" placeholder="Enter your email">
            <button type="submit">Subscribe</button>
            <div class="news-status"></div>
          </form>
          <p class="newsletter-disclaimer">
            By subscribing you agree to with our <a href="/privacy-policy"
              >Privacy Policy</a
            > and provide consent to receive updates from our company.
          </p>
        </div>

        <div class="footer-columns-desktop">
          <div class="footer-column">
            <h4>About Us</h4>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/teams">Teams</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>

          <div class="footer-column">
            <h4>Services</h4>
            <ul>
              <li><a href="/services/window">Window</a></li>
              <li><a href="/services/residential">Residential</a></li>
              <li><a href="/services/commercial">Commercial</a></li>
              <li><a href="/services/apartment">Apartment</a></li>
              <li><a href="/services/residential">Residential</a></li>
            </ul>
          </div>

          <div class="footer-column">
            <h4>Follow Us</h4>
            <ul>
              <li><a href="#"><Facebook size={16} color="#000000" fill={"#000000"} /> Facebook</a></li>
              <li><a href="#"><Instagram size={16} color="#000000" /> Instagram</a></li>
              <li><a href="#"><Twitter size={16} color="#000000" fill={"#000000"} /> Twitter</a></li>
              <li><a href="#"><Linkedin size={16} color="#000000" /> LinkedIn</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom">
        <p class="copyright">2023 Ddsgnr. All right reserved.</p>
        <div class="footer-links">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms-of-service">Terms of Service</a>
          <a href="/cookies-settings">Cookies Settings</a>
        </div>
      </div>
    </div>

    <div class="footer-mobile">
      <div class="footer-top-mobile">
        <div class="logo">
          <img src={logo.src} class="logo-icon" alt="Ddsgnr logo" />
          <span class="logo-text">Ddsgnr</span>
        </div>

        <nav class="footer-nav-mobile">
          <a href="/about">About</a>
          <a href="/project">Project</a>
          <a href="/contact">Contact</a>
          <a href="/services">Services</a>
        </nav>

        <div class="social-icons-mobile">
          <a href="#" aria-label="Facebook"
            ><Facebook size={16} color="#000000" fill={"#000000"} /></a
          >
          <a href="#" aria-label="Instagram"
            ><Instagram size={16} color="#000000" /></a
          >
          <a href="#" aria-label="Twitter"
            ><Twitter size={16} color="#000000" fill={"#000000"} /></a
          >
          <a href="#" aria-label="LinkedIn"
            ><Linkedin size={16} color="#000000" /></a
          >
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom-mobile">
        <p class="copyright">2023 Ddsgnr. All right reserved.</p>
        <div class="footer-links">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms-of-service">Terms of Service</a>
          <a href="/cookies-settings">Cookies Settings</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background-color: #ffffff;
    border-top: 1px solid #e5e5e5;
    font-family:
      "Roboto",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Oxygen,
      Ubuntu,
      Cantarell,
      sans-serif;
    margin-top: auto;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .footer-desktop {
    display: none;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    padding: 48px 0;
  }

  .newsletter-section-desktop {
    max-width: 400px;
  }

  .footer-columns-desktop {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-icon {
    width: 32px;
    height: auto;
  }

  .logo-text {
    font-size: 24px;
    font-weight: 600;
    color: #1a1a1a;
  }

  .footer-divider {
    height: 1px;
    background-color: #e5e5e5;
    margin: 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
  }

  .copyright {
    color: #666666;
    font-size: 14px;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    color: #666666;
    text-decoration: underline;
    font-size: 14px;
    transition: color 0.3s;
  }

  .footer-links a:hover {
    color: #333333;
  }

  .footer-mobile {
    display: block;
    padding: 40px 0 24px;
  }

  .footer-top-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 32px;
  }

  .footer-top-mobile .logo {
    margin-bottom: 24px;
  }

  .footer-nav-mobile {
    display: flex;
    gap: 24px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-nav-mobile a {
    color: #1a1a1a;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: color 0.3s;
  }

  .footer-nav-mobile a:hover {
    color: #666666;
  }

  .social-icons-mobile {
    display: flex;
    gap: 16px;
  }

  .social-icons-mobile a {
    color: #1a1a1a;
    transition: color 0.3s;
    display: flex;
    align-items: center;
  }

  .social-icons-mobile a:hover {
    color: #666666;
  }

  .newsletter-section-desktop {
    margin-bottom: 40px;
  }

  .newsletter-section-desktop .logo {
    margin-bottom: 16px;
  }

  .newsletter-text {
    color: #333333;
    font-size: 14px;
    margin-bottom: 16px;
    line-height: 1.5;
  }

  .newsletter-form {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .newsletter-form input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    font-size: 14px;
    outline: none;
  }

  .newsletter-form input::placeholder {
    color: #999999;
  }

  .newsletter-form input:focus {
    border-color: #1a1a1a;
  }

  .newsletter-form button {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s;
    white-space: nowrap;
  }

  .newsletter-form button:hover {
    background-color: #333333;
  }

  .newsletter-disclaimer {
    color: #666666;
    font-size: 12px;
    line-height: 1.5;
  }

  .newsletter-disclaimer a {
    text-decoration: underline;
    color: #666666;
  }

  .newsletter-disclaimer a:hover {
    color: #333333;
  }

  .footer-column h4 {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .footer-column ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-column ul li {
    margin-bottom: 12px;
  }

  .footer-column ul li a {
    color: #666666;
    text-decoration: none;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s;
  }

  .footer-column ul li a:hover {
    color: #333333;
  }

  .footer-bottom-mobile {
    text-align: center;
    padding-top: 24px;
  }

  .footer-bottom-mobile .copyright {
    margin-bottom: 16px;
  }

  .footer-bottom-mobile .footer-links {
    flex-direction: row;
    gap: 8px;
    align-items: center;
    justify-content: space-evenly;
  }

  @media (min-width: 769px) {
    .footer-desktop {
      display: block;
    }

    .footer-mobile {
      display: none;
    }

    .newsletter-section-desktop {
      margin-bottom: 0;
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      gap: 80px;
    }

    .footer-columns-desktop {
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .footer-nav-mobile {
      gap: 16px;
    }

    .footer-nav-mobile a {
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 15px;
    }

    .footer-mobile {
      padding: 32px 0 20px;
    }

    .footer-top-mobile {
      padding-bottom: 24px;
    }

    .footer-nav-mobile {
      gap: 12px;
    }

    .footer-nav-mobile a {
      font-size: 14px;
    }

    .footer-bottom-mobile {
      padding-top: 20px;
    }
  }
</style>
