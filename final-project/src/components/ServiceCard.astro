---
interface Props {
  image: string;
  title: string;
  description: string;
}

const { image, title, description } = Astro.props;
---

<div class="service-card">
  <div class="card-image">
    <img src={image} alt={title} />
  </div>
  <div class="card-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</div>

<style>
  .service-card {
    background-color: transparent;
    border: 0.5px solid #e5e5e5;
    border-radius: 5px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .card-image {
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 32px 24px;
    text-align: center;
  }

  .card-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .card-content p {
    font-size: 1rem;
    line-height: 1.6;
    color: #666666;
    margin: 0;
  }

  @media (max-width: 768px) {
    .card-image {
      height: 200px;
    }

    .card-content {
      padding: 24px 20px;
    }

    .card-content h3 {
      font-size: 18px;
    }
  }
</style>
