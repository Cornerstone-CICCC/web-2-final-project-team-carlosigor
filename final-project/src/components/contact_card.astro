---
import '../styles/global.css';
---

<section class="contact-container">
		<div class="container">
			<div class="contact-content">
				<h3>Contact us</h3>
				<h2>Request a quote</h2>
				<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
				<form id="contactForm">
					<div class="div1">
						<label for="fullname">Full name</label>
                        <input type="text" id="fullname" name="fullname" required />
					</div>
					<div class="div2">
						<label for="phone">Phone number</label>
                        <input type="tel" id="phone" name="phone" required />
					</div>
					<div class="div3">
						<label for="service">Select service</label>
                        <select id="service" name="service" required>
                        <option value=""></option>
                        <option value="window">Window Cleaning</option>
                        <option value="residential">Residential Cleaning</option>
                        <option value="commercial">Commercial Cleaning</option>
                        <option value="apartment">Apartment Cleaning</option>
                        <option value="construction">Construction Cleaning</option>
                        </select>
					</div>
					<div class="div4">
						<label for="time">Select time</label>
                        <select id="time" name="time" required>
                        <option value=""></option>
                        <option value="morning">Morning (8AM - 12PM)</option>
                        <option value="afternoon">Afternoon (12PM - 5PM)</option>
                        <option value="evening">Evening (5PM - 8PM)</option>
                        </select>
					</div>
					<div class="div5">
						<label for="message">Message</label>
                        <textarea id="message" name="message" rows="6" placeholder="Type your message..."></textarea>
					</div>
					<div class="div6">
						<input type="checkbox" id="terms" name="terms" required />
						<label for="terms">I accept the <a href="/terms">Terms</a></label>
					</div>

					<button type="submit" class="div7 btn-black" id="submitButton">Submit</button>
                    <div class="form-status" id="formStatus"></div>
				</form>
			</div>
			<img src="./images/person-5.jpg" alt="">
		</div>
</section>

<style>
    /* CONTACT US */

	.contact-container{
		background-color: #f7f7f7;
		margin-top: 112px;
	}
	.contact-container > div{
		display: grid; 
		grid-template-columns: 1fr 80px 1fr; 
		padding: 112px 0px;
	}
	.contact-container > div img{
		grid-column: 3;
		width: 100%;
		height: auto;
		display: block;
		border-radius: 5px;
	}
	.contact-content{
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.contact-content form{
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-auto-rows: auto;
		gap: 1rem;
	}
	.contact-content form div input:not([type="checkbox"]), .contact-content form div select, .contact-content form div textarea{
		border: none;
		outline: .5px black solid;
		outline-offset: -1px;
		border-radius: 5px;
		height: 40px;
		padding: 5px;
	}

	.div1 { grid-area: 1 / 1 / 2 / 2; }
	.div2 { grid-area: 1 / 2 / 2 / 3; }
	.div3 { grid-area: 2 / 1 / 3 / 2; }
	.div4 { grid-area: 2 / 2 / 3 / 3; }
	.div5 { grid-area: 3 / 1 / 4 / 3; }
	.div6 { grid-area: 4 / 1 / 5 / 3; }

	.contact-content form div:not(.div6){
		display: flex;
		flex-direction: column;
	}
	.div5 textarea{
		min-height: 180px;
		width: 100%;
	}
	.div6 a{
		text-decoration: underline;
	}
	.div7{
		width: fit-content;
	}
    @media (max-width: 768px) {
        .contact-container > div{
            padding: 48px 20px;
            display: grid; 
		    grid-template-columns: 1fr;
        }
        .contact-container > div img{
            display: none;
        }
        .contact-content form{
            grid-template-columns: 1fr;
	    }
        .contact-content form > div {
            grid-area: auto;
        }
    }
</style>