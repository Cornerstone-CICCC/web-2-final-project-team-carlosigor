---
import '../styles/global.css';
---
<div class="help-container">
    <div class="help-content">
        <h2>How we can help...</h2>
        <p>We offer a wide range of procedures to help you get the perfect smile. <br><a href="">Request a quote</a></p>
    </div>
    <a href="" class="btn-black">Request a quote</a>
</div>

<style>
    .help-container{
        border: 1px black solid;
        padding: 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 112px 0px;
    }
    .help-content a{
        text-decoration: underline;
        cursor: pointer;
    }
    @media (max-width: 768px) {
        .help-container{
            flex-direction: column;
            align-items: start;
            gap: 24px;
        }
        .help-content{
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }
        .help-container h2{
            font-size: 1.75rem;
        }
        .help-container p{
            font-size: 1.65rem;
        }
    }
</style>