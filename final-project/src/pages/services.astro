---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ServiceCard from '../components/ServiceCard.astro';
import oneBedroomImg from '../assets/one-bedroom.jpg';
import windowCleaningImg from '../assets/window-cleaning.jpg';
import residentialCleaningImg from '../assets/residential-cleaning.jpg';
import commercialCleaningImg from '../assets/commercial-cleaning.jpg';
import twoBedroomImg from '../assets/two-bedroom.jpg';
import constructionCleaningImg from '../assets/construction-cleaning.jpg';
---

<Layout>
  <Header />

  <main class="services-page">
    <section class="services-section">
      <div class="container">
        <SectionTitle
          title="Our Services"
          subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
        />

        <div class="services-grid" id="servicesGrid">
          <ServiceCard
            image={oneBedroomImg.src}
            title="One Bedroom Apartment"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />
          <ServiceCard
            image={windowCleaningImg.src}
            title="Window Cleaning"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />
          <ServiceCard
            image={residentialCleaningImg.src}
            title="Residential Cleaning"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />
          <ServiceCard
            image={constructionCleaningImg.src}
            title="Construction Cleaning"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />
          <ServiceCard
            image={commercialCleaningImg.src}
            title="Commercial Cleaning"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />

          <ServiceCard
            image={twoBedroomImg.src}
            title="Two Bedroom Apartment"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros."
          />
        </div>

        <button class="view-all-button" id="viewAllButton">View all</button>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">
        <div class="contact-content">
          <div class="contact-header">
            <p class="contact-label">Contact us</p>
            <h2>Request a quote</h2>
            <p class="contact-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </div>

          <form class="contact-form" id="contactForm">
            <div class="form-row">
              <div class="form-group">
                <label for="fullname">Full name</label>
                <input type="text" id="fullname" name="fullname" required />
              </div>
              <div class="form-group">
                <label for="phone">Phone number</label>
                <input type="tel" id="phone" name="phone" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="service">Select service</label>
                <select id="service" name="service" required>
                  <option value=""></option>
                  <option value="window">Window Cleaning</option>
                  <option value="residential">Residential Cleaning</option>
                  <option value="commercial">Commercial Cleaning</option>
                  <option value="apartment">Apartment Cleaning</option>
                  <option value="construction">Construction Cleaning</option>
                </select>
              </div>
              <div class="form-group">
                <label for="time">Select time</label>
                <select id="time" name="time" required>
                  <option value=""></option>
                  <option value="morning">Morning (8AM - 12PM)</option>
                  <option value="afternoon">Afternoon (12PM - 5PM)</option>
                  <option value="evening">Evening (5PM - 8PM)</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" placeholder="Type your message..."></textarea>
            </div>

            <div class="form-checkbox">
              <input type="checkbox" id="terms" name="terms" required />
              <label for="terms">I accept the <a href="/terms">Terms</a></label>
            </div>

            <div class="form-status" id="formStatus"></div>

            <button type="submit" class="submit-button" id="submitButton">Submit</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .services-page {
    min-height: 100vh;
    background-color: #F7F7F7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .services-section {
    padding: 80px 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .view-all-button {
    display: none;
    margin: 40px auto 0;
    padding: 14px 32px;
    background-color: transparent;
    color: #1a1a1a;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
  }

  /* .contact-section {
    padding: 80px 0;
  }

  .contact-content {
    max-width: 100%;
  }

  .contact-header {
    margin-bottom: 40px;
  }

  .contact-label {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  .contact-header h2 {
    font-size: 48px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .contact-description {
    font-size: 16px;
    color: #666666;
    line-height: 1.5;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px 16px;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    font-size: 14px;
    font-family: 'Roboto', sans-serif;
    background-color: #ffffff;
    outline: none;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #1a1a1a;
  }

  .form-group select {
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%23666666' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 16px center;
    padding-right: 40px;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group textarea::placeholder {
    color: #999999;
  }

  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .form-checkbox input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  .form-checkbox label {
    font-size: 14px;
    color: #666666;
    cursor: pointer;
  }

  .form-checkbox a {
    text-decoration: underline;
    color: #666666;
  }

  .form-checkbox a:hover {
    color: #1a1a1a;
  }

  .form-status {
    padding: 12px 16px;
    border-radius: 4px;
    font-size: 14px;
    text-align: center;
    display: none;
  }

  .form-status.success {
    display: block;
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-status.error {
    display: block;
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .submit-button {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 14px 32px;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s;
    align-self: flex-start;
  }

  .submit-button:hover {
    background-color: #333333;
  }

  .submit-button:disabled {
    background-color: #999999;
    cursor: not-allowed;
  }

  @media (min-width: 1400px) {
    .contact-content {
      max-width: 1000px;
    }
  }

  @media (max-width: 968px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .contact-header h2 {
      font-size: 36px;
    }
  }

  @media (max-width: 768px) {
    .services-section,
    .contact-section {
      padding: 60px 0;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .services-section,
    .contact-section {
      padding: 40px 0;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .services-grid.collapsed :global(.service-card:nth-child(n+4)) {
      display: none;
    }

    .view-all-button {
      display: block;
    }

    .view-all-button.hidden {
      display: none;
    }

    .contact-header h2 {
      font-size: 28px;
    }

    .submit-button {
      width: 100%;
    }
  }
</style>

<script>
  // Services grid "View all" functionality
  document.addEventListener('DOMContentLoaded', () => {
    const servicesGrid = document.getElementById('servicesGrid');
    const viewAllButton = document.getElementById('viewAllButton');

    if (servicesGrid && viewAllButton) {
      // Initially collapse the grid on mobile
      if (window.innerWidth <= 480) {
        servicesGrid.classList.add('collapsed');
      }

      // Handle button click
      viewAllButton.addEventListener('click', () => {
        servicesGrid.classList.remove('collapsed');
        viewAllButton.classList.add('hidden');
      });

      // Handle window resize
      window.addEventListener('resize', () => {
        if (window.innerWidth > 480) {
          servicesGrid.classList.remove('collapsed');
          viewAllButton.classList.add('hidden');
        } else if (!viewAllButton.classList.contains('hidden')) {
          servicesGrid.classList.add('collapsed');
        }
      });
    }
  });
</script>

<script src="../scripts/emailjs-handler.js"></script>
