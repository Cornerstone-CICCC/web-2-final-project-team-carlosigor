---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import manCleaningImg from '../assets/man-cleaning.jpg';  
---

<Layout>
  <Header />

  <main class="about-page">
    <section class="about-section">
      <div class="container">
        <div class="about-content">
          <div class="about-text">
            <p class="about-label">About Us</p>
            <h1>Let us takecare of all your cleaning service needs.</h1>
            <div class="about-description">
              <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat.Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat.Lo</p>
            </div>
            <button class="cta-button">Request a quote</button>
          </div>

          <div class="about-image">
            <img src={manCleaningImg.src} alt="Cleaning professional" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-page {
    min-height: 100vh;
    background-color: #F7F7F7;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .about-section {
    padding: 80px 0;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-label {
    font-size: 14px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
  }

  .about-text h1 {
    font-size: 48px;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.2;
    margin: 0;
  }

  .about-description {
    margin: 0;
  }

  .about-description p {
    font-size: 16px;
    line-height: 1.6;
    color: #666666;
    margin: 0;
  }

  .cta-button {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 14px 32px;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.3s;
    align-self: flex-start;
  }

  .cta-button:hover {
    background-color: #333333;
  }

  .about-image {
    width: 100%;
    height: 600px;
    border-radius: 8px;
    overflow: hidden;
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 968px) {
    .about-content {
      gap: 60px;
    }

    .about-text h1 {
      font-size: 40px;
    }

    .about-image {
      height: 500px;
    }
  }

  @media (max-width: 768px) {
    .about-section {
      padding: 60px 0;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-text h1 {
      font-size: 36px;
    }

    .about-image {
      height: 400px;
    }
  }

  @media (max-width: 480px) {
    .about-section {
      padding: 40px 0;
    }

    .about-text h1 {
      font-size: 28px;
    }

    .about-description p {
      font-size: 14px;
    }

    .about-image {
      height: 300px;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>
